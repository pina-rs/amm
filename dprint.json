{
	"incremental": true,
	"indentWidth": 2,
	"useTabs": true,
	"exec": {
		"commands": [
			{
				"command": "rustfmt --unstable-features --edition 2024",
				"exts": ["rs"]
			},
			{
				"command": "nixfmt",
				"exts": ["nix"]
			}
		]
	},
	"typescript": {
		"deno": true,
		"useTabs": true,
		"module.sortExportDeclarations": "caseInsensitive",
		"module.sortImportDeclarations": "caseInsensitive"
	},
	"json": {
		"deno": true,
		"useTabs": true
	},
	"toml": {
		"useTabs": true,
		"indentWidth": 2,
		"cargo.applyConventions": true
	},
	"markdown": {
		"deno": true,
		"textWrap": "never"
	},
	"excludes": [
		"**/dist",
		".devenv/**",
		"**/node_modules",
		"**/target",
		"**/pnpm-lock.yaml",
		"**/abi_layout.rs",
		"**/generated/**",
		"**/.pina-generated.json",
		"clients/dart/lib/pina_amm.dart",
		"programs/*/migrations/**",
		"release-notes/**",
		"changelog.md"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.95.13.wasm",
		"https://plugins.dprint.dev/json-0.21.0.wasm",
		"https://plugins.dprint.dev/markdown-0.20.0.wasm",
		"https://plugins.dprint.dev/exec-0.6.0.json@a054130d458f124f9b5c91484833828950723a5af3f8ff2bd1523bd47b83b364",
		"https://plugins.dprint.dev/toml-0.7.0.wasm"
	]
}
