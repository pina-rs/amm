---
/**
 * The document shell for pages outside the docs: head metadata, the shared
 * header and footer, and the theme switch. The theme preference uses
 * Starlight's storage key so the landing page and the docs always agree.
 */
import "../styles/tokens.css";
import "../styles/site.css";
import mark from "../assets/mark.svg?raw";
import { site } from "../lib/site";

interface Props {
	title?: string;
	description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title === undefined ? `${site.name} · Constant-product market maker for Solana` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<script is:inline>
			// Runs before paint so the page never flashes the wrong theme.
			try {
				const stored = localStorage.getItem("starlight-theme");
				const prefersLight = matchMedia("(prefers-color-scheme: light)").matches;
				document.documentElement.dataset.theme = stored === "light" || stored === "dark" ? stored : prefersLight ? "light" : "dark";
			} catch {
				// Storage can be unavailable (private windows); the default theme stands.
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="container site-header__inner">
				<a class="brand" href="/" aria-label={`${site.name} home`}>
					<span class="brand__mark" set:html={mark} />
					<span class="brand__name">Pina <span>AMM</span></span>
				</a>
				<nav class="site-nav" aria-label="Main">
					<a href="/docs/">Docs</a>
					<a href="/docs/integrating/">Integrate</a>
					<a href={site.repository} class="site-nav__icon" aria-label="GitHub repository">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
							></path></svg>
					</a>
					<button class="theme-toggle" type="button" aria-label="Switch colour theme" data-theme-toggle>
						<svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path
								d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"
							></path></svg>
						<svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.6A8.5 8.5 0 0 1 9.4 4a8.5 8.5 0 1 0 10.6 10.6Z"></path></svg>
					</button>
				</nav>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container site-footer__inner">
				<p class="site-footer__lede">
					<span class="brand__mark" set:html={mark} />
					<span>Built with <a href={site.pina}>Pina</a>. Apache-2.0.</span>
				</p>
				<nav class="site-footer__links" aria-label="Footer">
					<a href="/docs/">Documentation</a>
					<a href="/docs/security/">Security</a>
					<a href={`${site.repository}/releases`}>Releases</a>
					<a href={site.repository}>GitHub</a>
					<a href={site.bondingCurve}>Pina Bonding Curve</a>
				</nav>
			</div>
		</footer>
		<script>
			const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
			toggle?.addEventListener("click", () => {
				const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem("starlight-theme", next);
				} catch {
					// The choice still applies to this page without storage.
				}
			});
		</script>
	</body>
</html>
