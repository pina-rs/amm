---
import SiteShell from "../components/SiteShell.astro";
---

<SiteShell title="Page not found" description="This page does not exist.">
	<section class="container not-found">
		<p class="not-found__code">404 · off the curve</p>
		<h1 class="hero__title">This page isn't in the pool.</h1>
		<p class="hero__lede">The link may be out of date. The docs and the home page are still where you left them.</p>
		<div class="hero__actions">
			<a class="button button--primary" href="/docs/">Open the docs</a>
			<a class="button button--secondary" href="/">Go home</a>
		</div>
	</section>
</SiteShell>
