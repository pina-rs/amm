{
	"name": "@pina-rs/amm-website",
	"private": true,
	"type": "module",
	"description": "amm.pina.rs: the Pina AMM landing page and documentation, served by a Cloudflare Worker.",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "pnpm build && wrangler dev",
		"check": "astro check && tsc --noEmit --project worker/tsconfig.json",
		"test": "vitest run",
		"deploy": "pnpm build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.3",
		"@astrojs/starlight": "0.42.5",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"astro": "7.3.7",
		"satteri": "0.10.5"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@cloudflare/workers-types": "5.20261008.1",
		"typescript": "6.0.3",
		"vitest": "5.0.3",
		"wrangler": "4.148.0"
	}
}
