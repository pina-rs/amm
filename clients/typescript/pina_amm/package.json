{
	"name": "@pina-rs/amm",
	"version": "0.1.0",
	"description": "TypeScript client for the Pina AMM: instruction builders, account decoders, PDAs, events, and errors for @solana/kit",
	"keywords": [
		"solana",
		"amm",
		"pina",
		"defi",
		"solana-kit"
	],
	"homepage": "https://github.com/pina-rs/amm/tree/main/clients/typescript/pina_amm",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pina-rs/amm.git",
		"directory": "clients/typescript/pina_amm"
	},
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"check": "tsc --noEmit --project tsconfig.json",
		"journey": "tsx journeys/surfpool.journey.ts",
		"prepack": "pnpm build",
		"test": "pnpm build && node --test test/*.test.mjs"
	},
	"dependencies": {
		"@solana/program-client-core": "^8.3.0"
	},
	"peerDependencies": {
		"@solana/kit": "^8.3.0"
	},
	"devDependencies": {
		"@solana/kit": "^8.3.0",
		"@types/node": "^24.6.0",
		"tsup": "^8.5.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"module": "./dist/index.js"
}
